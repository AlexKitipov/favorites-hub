+
+export interface FavoriteItem {
+  id: string;
+  title: string;
+  url: string;
+  sourceBrowser: SourceBrowser;
+}
+
+export interface RecentApp {
+  name: string;
+  path: string;
+  icon?: string;
+  lastUsed: Date;
+}
+
+export interface RecentFile {
+  name: string;
+  path: string;
+  type: string;
+  lastOpened: Date;
+}
+
+export interface InstalledProgram {
+  name: string;
+  path: string;
+  icon?: string;
