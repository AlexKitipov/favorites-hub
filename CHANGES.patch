+          <span className="favorite-card__icon-fallback">{title.charAt(0).toUpperCase()}</span>
+        )}
+      </span>
+      <span className="favorite-card__title">{title}</span>
+      <span className="favorite-card__browser-label">{subtitle}</span>
+    </button>
+  );
+}
